{
  "name": "@hall/postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test",
    "test:council": "bash sql/council/test/run.sh",
    "test:document": "bash sql/test/document/run.sh"
  },
  "dependencies": {
    "@hall/domain": "*",
    "pg": "^8.23.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}

{
  "name": "@hall/postgres",
  "version": "1.0.3",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test",
    "test:council": "node ../../tests/postgres/run.mjs --pgtap council",
    "test:document": "node ../../tests/postgres/run.mjs --pgtap document"
  },
  "dependencies": {
    "@code-moniker/client": "0.13.0",
    "@hall/contracts": "*",
    "@hall/domain": "*",
    "@ng-galien/postgresql-catalog": "0.1.5",
    "pg": "^8.23.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}

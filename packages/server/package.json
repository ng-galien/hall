{
  "name": "@hall/server",
  "version": "1.3.0",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "dev": "cross-env HALL_DEV_AUTO_LOGIN=true nodemon --watch src --ext ts --exec 'node --import tsx src/index.ts'",
    "start": "node dist/index.js",
    "seed:dev": "node ../../scripts/seed/seed-dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --config ../../tests/postgres/vitest.config.ts",
    "test:vitest": "vitest run --config ../../tests/postgres/vitest.config.ts",
    "test:integration": "vitest run --config ../../tests/postgres/vitest.config.ts --exclude src/__tests__/postgresPersistence.test.ts",
    "test:coverage": "vitest run --config ../../tests/postgres/vitest.config.ts --coverage",
    "test:mutation:policy": "stryker run stryker.config.mjs"
  },
  "dependencies": {
    "@hall/api-contract": "*",
    "@hall/contracts": "*",
    "@hall/domain": "*",
    "@hall/mcp": "*",
    "@hall/postgres": "*",
    "@hall/templating": "*",
    "awilix": "^13.0.3",
    "embedded-postgres": "17.10.0-beta.17",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "file-type": "^22.0.2",
    "mammoth": "^1.12.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "playwright": "^1.62.1",
    "sanitize-html": "^2.17.7",
    "turndown": "^7.2.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.9.0",
    "nodemon": "^3.1.14",
    "pdfjs-dist": "^6.3.289",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "optionalDependencies": {
    "edge-js": "24.0.5"
  }
}

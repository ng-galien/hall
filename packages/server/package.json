{
  "name": "@hall/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "cross-env HALL_DEV_AUTO_LOGIN=true nodemon --watch src --ext ts --exec 'node --import tsx src/index.ts'",
    "start": "node dist/index.js",
    "seed:dev": "node scripts/seed-dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hall/api-contract": "*",
    "@hall/domain": "*",
    "@hall/templating": "*",
    "awilix": "^13.0.3",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "playwright": "^1.62.1",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}

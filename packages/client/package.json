{
  "name": "@hall/client",
  "version": "1.2.0",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild:docs": "npm --prefix ../.. run build -w @hall/contracts && npm --prefix ../.. run build -w @hall/api-contract && npm --prefix ../.. run build -w @hall/domain && npm --prefix ../.. run build -w @hall/templating",
    "build:docs": "vite build --config vite.docs.config.ts && mv dist-docs/docs-site.html dist-docs/index.html",
    "zip:docs": "npm run build:docs && cd dist-docs && rm -f ../hall-docs.zip && zip -q ../hall-docs.zip index.html && echo hall-docs.zip",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run tests/*.test.mjs --exclude tests/*.acceptance.test.mjs",
    "test:e2e": "node e2e/run.mjs",
    "docs:captures": "cross-env HALL_DOCS_CAPTURES=true node e2e/run.mjs --project=docs-captures",
    "test:i18n-hmr": "vitest run tests/i18n-hmr.acceptance.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fullcalendar/react": "^7.1.0",
    "@hall/api-contract": "*",
    "@hall/domain": "*",
    "@hall/templating": "^1.2.0",
    "@mdx-js/react": "^3.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@stepperize/react": "^7.0.0",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-list": "^3.30.5",
    "@tiptap/extension-mention": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.30.5",
    "@univerjs/core": "^0.25.1",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ol": "^10.10.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "rehype-raw": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "temporal-polyfill": "^1.0.4",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.2"
  }
}

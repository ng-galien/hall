{
  "$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
  "files": {
    "includes": [
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "packages/**/*.mjs",
      "scripts/**/*.mjs",
      "tests/**/*.ts",
      "tests/**/*.mjs"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "recommended": true,
      "complexity": { "noUselessCatch": "error" },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        "noEmptyBlockStatements": "error",
        "noExplicitAny": "error",
        "noSkippedTests": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/src/**", "!**/__tests__/**", "!**/*.test.*"],
      "linter": { "rules": { "suspicious": { "noFocusedTests": "off" } } }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all" } }
}
